FROM ubuntu:22.04

# Avoid prompts during apt installation
ENV DEBIAN_FRONTEND=noninteractive

# Install dependencies for Rust, Node, and Tauri/WebKit
RUN apt-get update && apt-get install -y \
    curl wget file build-essential \
    libwebkit2gtk-4.1-dev \
    libxdo-dev \
    libssl-dev \
    libayatana-appindicator3-dev \
    librsvg2-dev \
    xvfb \
    git \
    sudo \
    protobuf-compiler \
    dbus-x11 \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js 20
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs

# Install Rust
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /app
COPY . .

WORKDIR /app/gui
# Install Node dependencies
RUN npm ci

# Pre-compile the Rust backend in debug mode to prevent Playwright socket timeouts during cold starts
RUN cd src-tauri && cargo build || true

# Install Playwright browsers
RUN npx playwright install --with-deps

# We will run this via docker run
CMD ["npm", "run", "test:e2e:headless"]
