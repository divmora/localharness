{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-create",
    "opener:default",
    "shell:default",
    "websocket:default",
    "dialog:default",
    "core:webview:allow-create-webview-window",
    "notification:default",
    "core:tray:default",
    "os:default",
    "core:window:default",
    "playwright:default"
  ]
}